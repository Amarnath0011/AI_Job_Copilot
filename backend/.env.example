# MySQL connection (URL-encode special characters in the password)
DATABASE_URL=mysql+pymysql://copilot_user:CHANGE_ME@127.0.0.1:3306/ai_job_copilot

# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI provider credentials
HF_TOKEN=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Cloudinary credentials (required for resume uploads)
CLOUDINARY_CLOUD_NAME=
